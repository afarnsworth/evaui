{
  "name": "evaui",
  "version": "1.0.0",
  "private": true,
  "description": "NERV-style motion graphics built with Remotion",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render MagiSequence out/magi-sequence.mp4",
    "render:ep2": "remotion render UnfamiliarScreen out/unfamiliar-screen.mp4",
    "still": "remotion still MagiSequence out/still.png --frame=560",
    "sfx": "node scripts/make-sfx.mjs",
    "glyphs": "node scripts/sync-glyphs.mjs",
    "typecheck": "tsc --noEmit",
    "tracker": "node scripts/build-tracker.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@fontsource/shippori-mincho-b1": "^5.3.0",
    "@remotion/cli": "4.0.529",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
